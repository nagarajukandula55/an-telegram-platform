# Everything below is self-contained — no Docker, no Postgres/Redis/MinIO
# servers to run. The database is a local SQLite file, the job queue is a
# table in that same file, and attachments are stored on local disk.

# SQLite file, resolved relative to packages/database/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Local-disk attachment storage
ATTACHMENT_STORAGE_DIR="./data/attachments"
ATTACHMENT_SIGNING_SECRET="change-me-in-every-environment"
# Base URL the API is reachable at — used to build signed attachment download links
PUBLIC_API_URL="http://localhost:4000"

# Auth
JWT_SECRET="change-me-in-every-environment"

# Encrypts secrets that must live in the database rather than an env var —
# chiefly MTProto session strings, generated at runtime by the phone/code/2FA
# login flow. Any random passphrase; set a real one in production.
CREDENTIAL_ENCRYPTION_KEY="change-me-in-every-environment"

# Telegram Bot API — create a bot with @BotFather on Telegram, it gives you
# this token. One bot = one connector; if you run multiple bot connectors,
# each Connector row's `credentialRef` names a different env var here.
TELEGRAM_BOT_TOKEN=""

# Optional: only used if a connector is switched into webhook mode instead
# of the default long-polling (see connector-telegram-bot). The secret you
# pass to Telegram's setWebhook `secret_token` param — Telegram echoes it
# back on every webhook POST so we can verify the request is really from them.
TELEGRAM_WEBHOOK_SECRET=""

# Telegram MTPROTO (user-account login, like a real Telegram client) — get
# these from https://my.telegram.org -> API Development Tools. Per-connector
# overrides can also live in Connector.config (apiId/apiHash), these are just
# the defaults used when a connector doesn't set its own.
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
